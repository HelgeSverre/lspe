{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LSPE run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "created_at", "config_hash", "model_repo", "model_revision", "prompt_count", "selected_layers", "raw_dose", "matched_temperature"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "config_hash": {"type": "string"},
    "model_repo": {"type": "string"},
    "model_revision": {"type": "string"},
    "prompt_count": {"type": "integer", "minimum": 0},
    "selected_layers": {"type": "array", "items": {"type": "integer"}},
    "raw_dose": {"type": "number"},
    "matched_temperature": {"type": ["number", "null"]}
  },
  "additionalProperties": false
}
