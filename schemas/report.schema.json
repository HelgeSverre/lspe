{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LSPE report",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "primary", "validity", "competence", "degeneration", "replication", "integrity", "artifact_root_hash", "secondary", "execution", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUPPORTED", "PROMISING", "NOT_SUPPORTED", "DEGENERATIVE", "INVALID_RUN"]},
    "primary": {"type": "object", "required": ["metric", "contrast", "estimate", "ci95", "p_value", "n_prompts", "median", "standardized_effect", "positive", "zero", "negative"]},
    "validity": {"type": "object"},
    "competence": {"type": "object"},
    "degeneration": {"type": "object"},
    "replication": {"type": "object"},
    "integrity": {"type": "object"},
    "artifact_root_hash": {"type": ["string", "null"]},
    "secondary": {"type": "object"},
    "execution": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
